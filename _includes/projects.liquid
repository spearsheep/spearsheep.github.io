{% assign project_link = project.url | relative_url %}
{% if project.redirect %}{% assign project_link = project.redirect %}{% endif %}
<article class="project-card{% if project.spotlight %} project-card--spotlight{% endif %}">
  <a
    class="project-card__link"
    href="{{ project_link }}"
    {% if project.redirect %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
  >
    <div class="project-card__meta">
      <span>{{ project.category }}</span><span>{{ project.year }}</span>
    </div>
    {% if include.heading_level == 'h2' %}
      <h2>{{ project.title }}</h2>
    {% else %}
      <h3>{{ project.title }}</h3>
    {% endif %}
    <p>{{ project.description }}</p>
    {% if project.img %}
      <div class="project-card__visual{% if project.img_fit == 'contain' %} project-card__visual--contain{% endif %}">
        <img
          src="{{ project.img | relative_url }}"
          alt="{{ project.img_alt | escape }}"
          width="{{ project.img_width }}"
          height="{{ project.img_height }}"
          loading="lazy"
          decoding="async"
        >
      </div>
    {% endif %}
    {% if project.impact %}
      <p class="project-card__impact">{{ project.impact }}</p>
    {% endif %}
    <span class="project-card__cta">
      {%- if project.redirect %}Visit project{% else %}Read case study{% endif %}
      <span aria-hidden="true">↗</span></span
    >
  </a>
</article>
