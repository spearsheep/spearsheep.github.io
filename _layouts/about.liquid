---
layout: default
---
<div class="portfolio-home">
  <header class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-eyebrow"><span class="status-dot" aria-hidden="true"></span>{{ page.eyebrow }}</p>
      <h1 id="home-title" class="home-title">Jun Yu Chen</h1>
      <p class="home-deck">{{ page.hero }}</p>
      <div class="home-actions" aria-label="Primary links">
        <a class="button button--primary" href="{{ '/assets/pdf/Jun_Yu_Chen_Resume.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer"
          >View résumé <span aria-hidden="true">↗</span></a
        >
        <a class="button button--quiet" href="mailto:{{ site.email }}">Email me <span aria-hidden="true">↗</span></a>
      </div>
      {% if page.focus %}
        <ul class="focus-list" aria-label="Research interests">
          {% for item in page.focus %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    <aside class="home-portrait" aria-label="Portrait of Jun Yu Chen">
      <div class="home-portrait__frame">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path class="home-portrait__image" alt="Jun Yu Chen" cache_bust=true %}
      </div>
      <div class="home-portrait__caption"><span>Philadelphia, PA</span><span>Penn MSE · '27</span></div>
    </aside>
  </header>

  <section class="home-intro" aria-labelledby="about-heading">
    <p class="section-index">About</p>
    <h2 id="about-heading">Building learning systems from research prototypes to production.</h2>
    <div class="home-intro__copy">{{ content }}</div>
  </section>

  <section class="home-section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <p class="section-index">Selected work</p>
        <h2 id="work-heading">Machine learning systems, from production to research.</h2>
      </div>
      <a class="section-link" href="{{ '/projects/' | relative_url }}">All projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-grid project-grid--home">
      {% assign featured_projects = site.projects | where: 'featured', true | sort: 'importance' %}
      {% for project in featured_projects -%}
        {%- include projects.liquid -%}
      {%- endfor %}
    </div>
  </section>

  {% if page.news and site.announcements.enabled %}
    <section class="home-section home-section--compact" aria-labelledby="news-heading">
      <div class="section-heading">
        <div>
          <p class="section-index">Now</p>
          <h2 id="news-heading">Recent updates.</h2>
        </div>
        <a class="section-link" href="{{ '/news/' | relative_url }}">Archive <span aria-hidden="true">→</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section" aria-labelledby="papers-heading">
      <div class="section-heading">
        <div>
          <p class="section-index">Publications</p>
          <h2 id="papers-heading">Selected research.</h2>
        </div>
        <a class="section-link" href="{{ '/publications/' | relative_url }}">View all <span aria-hidden="true">→</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <section class="home-contact" aria-labelledby="contact-heading">
    <div>
      <p class="section-index">Contact</p>
      <h2 id="contact-heading">Let's build something thoughtful.</h2>
      <p>I am open to collaborations across agentic systems, reinforcement learning, natural language processing, and human cognition.</p>
    </div>
    <div class="home-contact__actions">
      <a class="button button--primary" href="mailto:{{ site.email }}">
        {{- site.email }}
        <span aria-hidden="true">↗</span></a
      >
      {% if page.social %}
        <div class="social" aria-label="Social profiles">
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      {% endif %}
    </div>
  </section>
</div>
